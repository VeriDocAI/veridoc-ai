# Project Specific ML/Data Ignores
# Ignore datasets in data/ except the .gitkeep files
data/**/*
!data/**/.gitkeep

# Ignore model checkpoints/weights in models/ except the .gitkeep files
models/**/*
!models/**/*.py
!models/**/.gitkeep