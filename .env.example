# VeriDoc AI Environment Configuration Template
# Copy this file to '.env' and fill in your local secrets.

# General App Settings
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Logging Configuration
LOG_LEVEL=DEBUG

# ML Experiment Tracking (Weights & Biases)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=veridoc-ai

# Database / Storage (if applicable)
# DATABASE_URL=postgresql://user:password@localhost:5432/veridoc_db
